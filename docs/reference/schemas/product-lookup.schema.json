{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodgut.app/schemas/product-lookup-2.0.schema.json",
  "title": "GoodGut product lookup response 2.0",
  "oneOf": [
    { "$ref": "#/$defs/found" },
    { "$ref": "#/$defs/notFound" },
    { "$ref": "#/$defs/sourceError" }
  ],
  "$defs": {
    "commonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": { "provider": { "const": "open_food_facts" } }
    },
    "foundSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "providerProductUrl", "fetchedAt"],
      "properties": {
        "provider": { "const": "open_food_facts" },
        "providerProductUrl": { "type": ["string", "null"], "format": "uri" },
        "fetchedAt": { "type": "string", "format": "date-time" }
      }
    },
    "found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "outcome", "barcode", "source", "product"],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "outcome": { "const": "found" },
        "barcode": { "type": "string", "pattern": "^[0-9]+$" },
        "source": { "$ref": "#/$defs/foundSource" },
        "product": { "$ref": "https://goodgut.app/schemas/normalized-product-2.0.schema.json" }
      }
    },
    "notFound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "outcome", "barcode", "source", "reason"],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "outcome": { "const": "not_found" },
        "barcode": { "type": "string", "pattern": "^[0-9]+$" },
        "source": { "$ref": "#/$defs/commonSource" },
        "reason": { "const": "not_in_source" }
      }
    },
    "sourceError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "outcome", "barcode", "source", "errorCategory"],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "outcome": { "const": "source_error" },
        "barcode": { "type": "string", "pattern": "^[0-9]+$" },
        "source": { "$ref": "#/$defs/commonSource" },
        "errorCategory": { "enum": ["rate_limited", "network_error", "invalid_source_response", "source_unavailable"] }
      }
    }
  }
}
